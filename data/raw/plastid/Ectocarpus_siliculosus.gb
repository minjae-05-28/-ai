                     /EC_number="7.1.2.2"
                     /note="This family represents subunits called delta (in
                     mitochondrial ATPase) or epsilon (in bacteria or
                     chloroplast ATPase) in the F1 complex of F-ATPases. The
                     interaction site of subunit C of the F0 complex with the
                     delta or epsilon subunit of the F1 complex may be
                     important for connecting the rotor of F1 (gamma subunit)
                     to the rotor of F0 (C subunit)."
                     /codon_start=1
                     /transl_table=11
                     /product="ATP synthase CF1, subunit epsilon"
                     /protein_id="YP_003289266.1"
