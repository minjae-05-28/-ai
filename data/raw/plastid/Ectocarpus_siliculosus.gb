     CDS             30274..30666
                     /gene="rpl12"
                     /locus_tag="GFC16_pgp122"
                     /note="This family of ribosomal protein L7/L12 is some of
                     the proteins from the 50S large ribosomal subunit. L7/L12
                     is present in each 50S subunit in four copies organised as
                     two dimers. The L8 protein complex consisting of two
                     dimers of L7/L12 and L10 in E. coli ribosomes is assembled
                     on the conserved region of 23 S rRNA termed the GTPase-
                     associated domain. The L7/L12 dimer probably interacts
                     with EF-Tu. L7 and L12 only differ in a single post
                     translational modification of the addition an acetyl group
                     to the N terminus of L7."
                     /codon_start=1
                     /transl_table=11
                     /product="50S ribosomal protein L12"
